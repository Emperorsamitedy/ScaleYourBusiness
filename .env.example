# Copy to .env and fill in. .env is gitignored and never committed.

# Port 5433, NOT the Postgres default 5432: docker-compose.yml maps the
# container to host port 5433 because a system Postgres commonly occupies
# 5432 (it does on the primary dev machine). If you change the mapping in
# docker-compose.yml, change it here too.
DATABASE_URL=postgresql://syb:syb_local_dev@127.0.0.1:5433/syb

# https://console.anthropic.com/ — required from Session L (interviewer).
ANTHROPIC_API_KEY=

# Question selection: "llm" (Sonnet, production) or "deterministic"
# (first open candidate in bank order — for UI dev and offline demos).
INTERVIEWER_MODE=deterministic

# M-2 — which Sonnet and which Opus (lib/llm/models.ts). Leave BOTH empty:
# empty means today's models exactly. Changing either is a deliberate step
# taken only AFTER the recalibration run (`npm run recalibrate:diagnosis`,
# with `--sonnet` for the interviewer) has compared the two models on the
# real businesses and the owner has accepted the result. Any other value
# fails the call loudly rather than running a model nobody chose.
#   SONNET_MODEL     claude-sonnet-5 (empty) | claude-sonnet-5-5
#                    — the interviewer, chat answers, content drafts, the
#                    support answer and the support reply draft
#   DIAGNOSIS_MODEL  claude-opus-4-8 (empty) | claude-opus-5-5
#                    — the diagnosis, its recommendations, the care review
SONNET_MODEL=
DIAGNOSIS_MODEL=

# P0-07b — Sentry error monitoring. Both empty = monitoring fully off.
# Server-side DSN (same value as the public one is fine for our setup).
SENTRY_DSN=
# Client-side DSN — NEXT_PUBLIC_ because the browser bundle needs it.
NEXT_PUBLIC_SENTRY_DSN=
# Shared secret for the deliberate-exception route /api/debug-sentry.
SENTRY_TEST_KEY=

# ── Session I: auth + payment ──────────────────────────────────────────

# Absolute origin used in emailed links and Stripe redirect URLs.
# Empty = derived from the request, which is right for local dev.
APP_URL=

# https://resend.com — magic-link login emails. Empty = the sign-in link
# is shown on screen instead of emailed (dev and pilot behaviour).
RESEND_API_KEY=
# The From: header Resend sends with. Must be a verified domain there.
EMAIL_FROM=
# Optional, and recommended before the first real campaign: the From address
# campaign email sends from, on its own verified sending subdomain (e.g.
# "SYB <hello@campaigns.example.com>"), so spam complaints about a
# campaign can't throttle the address sign-in links come from. Empty =
# campaigns share EMAIL_FROM with sign-in, and /connections says so.
CAMPAIGN_EMAIL_FROM=

# P4-09 — inbound support email through Resend's receiving (the same
# RESEND_API_KEY fetches each received email's body). Point the webhook
# at <APP_URL>/api/support/inbound for the event email.received and paste
# its signing secret (whsec_…) here. Empty = the inbound endpoint refuses
# every delivery (503) instead of accepting an unverified one.
RESEND_WEBHOOK_SECRET=
# P4-17 — campaign delivery signals. A second Resend webhook, pointed at
# <APP_URL>/api/email/events for email.delivered, email.bounced,
# email.complained and email.suppressed (nothing else: opens and clicks are
# deliberately not tracked). Paste ITS signing secret here; each Resend
# webhook has its own. A spam complaint suppresses the address for good.
# Empty = the endpoint refuses every delivery (503) and /customers says
# delivery isn't reported.
RESEND_EVENTS_WEBHOOK_SECRET=
# The domain Resend receives on: a custom domain whose MX record points at
# Resend, or the <id>.resend.app subdomain from Emails → Receiving. Each
# business gets s-<token>@<this domain> to forward its support mailbox to.
# Empty = /support says inbound email isn't set up yet.
SUPPORT_INBOUND_DOMAIN=

# https://dashboard.stripe.com/apikeys — payments. Empty = the report
# gate is UNARMED and generation is free (today's pilot behaviour).
# Use sk_test_… until go-live; every armed path works in test mode.
STRIPE_SECRET_KEY=
# https://dashboard.stripe.com/webhooks — signing secret of the endpoint
# pointed at /api/stripe/webhook. Required once STRIPE_SECRET_KEY is set.
STRIPE_WEBHOOK_SECRET=
# One-off report price in MINOR units + ISO currency. Empty = €49.00.
REPORT_PRICE_MINOR=
REPORT_CURRENCY=

# Social sign-in (lib/auth/oauth.ts). Each provider's button only works
# once ALL of its keys are set; empty = that provider is off and magic
# link stays the way in. Register the redirect URI
#   <APP_URL>/api/auth/oauth/<google|microsoft|apple>/callback
# with each provider.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# https://entra.microsoft.com → App registrations ("common" tenant)
# Work and school accounts sign in only when the token carries xms_edov
# (email domain owner verified): in the app registration, Token
# configuration → Add optional claim → ID → xms_edov. Without it, only
# personal Microsoft accounts can sign in — any tenant's admin can set
# a user's email claim, so it is never trusted alone (security review
# 2026-10-17).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# https://developer.apple.com/account/resources → Services ID + Sign in
# with Apple key. APPLE_CLIENT_ID is the Services ID. APPLE_PRIVATE_KEY is
# the .p8 contents; literal \n sequences are turned into newlines.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Shared secret for /ops and /api/ops (P1-53). Empty = both are off.
OPS_KEY=

# Vercel cron auth for /api/cron/weekly-watch (P1-46),
# /api/cron/connector-sync (P2-06), /api/cron/execute-due (P3-20e) and
# /api/cron/faq-cluster (P4-12). Vercel sends it as
# "Authorization: Bearer <value>" automatically when set. Empty = off.
CRON_SECRET=

# ── Phase 2: connectors ────────────────────────────────────────────────

# P2-03 — encrypts owner connection secrets (Stripe keys, shop tokens) at
# rest with AES-256-GCM. 32 random bytes, base64 or hex. Required the
# moment a connector is connected; a lost key means every connection
# must be re-authorised. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTOR_KEY=

# ── Phase 3 Session D: publishing ──────────────────────────────────────

# P3-20c — Vercel Blob, where rendered clips and images wait at a public
# URL for the platform to fetch at publish time (Instagram cURLs media).
# Create a store in the Vercel dashboard (Storage → Blob) and paste its
# read-write token. Empty = attaching media to a content item fails
# loudly; drafting, planning and every test still work (in-memory store).
BLOB_READ_WRITE_TOKEN=

# THE REAL-WRITE GATE (P3-21b, Session D's D2 done-when). The first real
# publish must wait until Phase 2's two-week unattended-sync clock has
# completed — TASKS-PHASE3.md, Session D, "The gate, amended". Until this
# is exactly "on", the execution engine refuses every Meta publish (and
# every other real-platform write) with a named reason, sends nothing,
# and leaves the approved post approved; /content says publishing is
# switched off. Turn it on only once that clock is judged complete, and
# record the date in TASKS-PHASE3.md. The emergency stop overrides it.
SESSION_D_REAL_WRITES=

# P3-20i — what Meta has approved SYB for: standard | advanced. Leave it
# at standard until App Review (Advanced Access), Business Verification
# and Tech Provider verification all exist. At standard the connection
# screen offers only the pilot routes and says open sign-up is waiting on
# those approvals; anything other than "advanced" reads as standard.
META_ACCESS_LEVEL=standard

# P3-20j — Facebook Login for pilot route 1 (invited testers). SYB's own
# Meta app (developers.facebook.com → the "SYB" app → App settings → Basic).
# The "Sign in with Facebook" button on /connections works only when BOTH
# are set; empty = it is shown disabled and says it isn't switched on yet.
# The secret never leaves the server and is never logged. During the pilot
# each owner must first be added as a Tester (App Roles) by Samuel or Tedi.
META_APP_ID=
META_APP_SECRET=
# The OAuth redirect, byte-identical to the one registered in the Meta app
# (Facebook Login → Settings → Valid OAuth Redirect URIs). Set it in
# production. Empty = <APP_URL or the request's origin>/api/connections/meta/callback,
# the same derivation the Google/Microsoft/Apple sign-in redirects use.
META_OAUTH_REDIRECT_URI=

# P3-50 — niche research: a USER access token for Meta's Ad Library API
# (Graph ads_archive), from a developer account whose identity and
# location Meta has confirmed (facebook.com/ID). Read-only: the token must
# carry no permission beyond public_profile, and every read checks that
# before asking the Library. Sent in a header, never stored. Empty = the
# Creative studio says niche research isn't set up; nothing else changes.
# Meta shows commercial ads only for ads delivered in the EU (and, to be
# verified, the UK); elsewhere the screen says so and reads nothing.
META_AD_LIBRARY_TOKEN=
