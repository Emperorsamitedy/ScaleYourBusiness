{
  "version": "1",
  "about": "The idea check (TASKS-IDEAS.md, D93): a person with a business idea answers these, and lib/ideas sets the plan's own arithmetic beside Eurostat's figures for that kind of business in that country. Questions, options and every threshold live here as data; the code only applies them. Money is whole units of the chosen currency in the form and integer minor units everywhere after (rule 1).",
  "questions": [
    { "id": "sector", "kind": "business_type" },
    { "id": "country", "kind": "country" },
    { "id": "customer", "kind": "choice", "options": ["consumer", "business", "both"] },
    {
      "id": "revenue_model",
      "kind": "choice",
      "options": ["one_off", "subscription", "commission", "recruitment"]
    },
    { "id": "currency", "kind": "currency" },
    { "id": "price", "kind": "money", "min": 1, "unless": { "revenue_model": "recruitment" } },
    { "id": "variable_cost", "kind": "money", "min": 0, "unless": { "revenue_model": "recruitment" } },
    {
      "id": "customers_month",
      "kind": "count_or_unknown",
      "min": 1,
      "max": 1000000,
      "unless": { "revenue_model": "recruitment" }
    },
    { "id": "fixed_month", "kind": "money", "min": 0, "unless": { "revenue_model": "recruitment" } },
    { "id": "startup", "kind": "money", "min": 0, "unless": { "revenue_model": "recruitment" } },
    { "id": "capital", "kind": "money", "min": 0, "unless": { "revenue_model": "recruitment" } },
    { "id": "team", "kind": "count", "min": 1, "max": 500, "unless": { "revenue_model": "recruitment" } },
    {
      "id": "ramp_months",
      "kind": "choice",
      "options": ["1", "3", "6", "12"],
      "unless": { "revenue_model": "recruitment" }
    }
  ],
  "currencies": ["EUR", "BGN", "CZK", "DKK", "HUF", "PLN", "RON", "SEK", "GBP", "CHF", "NOK", "USD"],
  "currency_by_country": {
    "BG": "BGN",
    "CZ": "CZK",
    "DK": "DKK",
    "HU": "HUF",
    "PL": "PLN",
    "RO": "RON",
    "SE": "SEK",
    "GB": "GBP",
    "CH": "CHF",
    "NO": "NOK"
  },
  "max_amount_major": 100000000,
  "horizon_months": 36,
  "first_connector": {
    "about": "I-52: the first connector suggested at launch, from what the plan rests on. By revenue model first, then by kind of business, then the default. Provider ids are lib/connectors/scopes.ts's.",
    "by_model": { "subscription": "stripe", "commission": "stripe" },
    "by_sector": {
      "ecommerce_store": "shopify",
      "restaurant": "square",
      "cafe": "square",
      "bar": "square",
      "retail_shop": "square",
      "salon_beauty": "square",
      "barber": "square"
    },
    "default": "stripe"
  },
  "plan_vs_actual": { "min_measured_days": 30 },
  "local": {
    "about": "Local competition (owner, 2026-11-17, D98): how many places of the same kind are mapped on OpenStreetMap in the chosen city, from the dated snapshot specs/local-counts-v1.json (scripts/fetch-local.ts). A group lists OSM tag selectors, each [key, regex]; a business type maps to one group, or to null with the reason it isn't counted. OpenStreetMap is volunteer-mapped: a count is a floor, never a total (rule 37).",
    "cities_per_country": 3,
    "groups": {
      "restaurants": [["amenity", "^(restaurant|fast_food)$"]],
      "cafes": [["amenity", "^cafe$"]],
      "bars": [["amenity", "^(bar|pub)$"]],
      "hairdressers": [["shop", "^hairdresser$"]],
      "beauty": [["shop", "^(beauty|hairdresser|cosmetics)$"]],
      "fitness": [["leisure", "^fitness_centre$"]],
      "massage_spa": [["shop", "^massage$"], ["leisure", "^spa$"]],
      "health": [["amenity", "^(clinic|doctors|dentist)$"]],
      "childcare": [["amenity", "^(childcare|kindergarten)$"]],
      "car_repair": [["shop", "^(car_repair|tyres)$"]],
      "stays": [["tourism", "^(hotel|guest_house|hostel|apartment)$"]],
      "estate_agents": [["office", "^estate_agent$"]],
      "bakeries": [["shop", "^(bakery|pastry)$"]]
    },
    "by_type": {
      "restaurant": "restaurants",
      "cafe": "cafes",
      "bar": "bars",
      "barber": "hairdressers",
      "salon_beauty": "beauty",
      "gym_fitness": "fitness",
      "wellness_spa": "massage_spa",
      "clinic_health": "health",
      "childcare": "childcare",
      "automotive": "car_repair",
      "tourism_accommodation": "stays",
      "real_estate": "estate_agents",
      "food_production": "bakeries"
    },
    "not_counted": {
      "online": ["ecommerce_store", "software_saas", "it_services", "agency_marketing", "consulting", "professional_services"],
      "too_broad": ["retail_shop", "other"],
      "rarely_mapped": ["construction", "trades_services", "cleaning_services", "education_training", "events", "photography_creative", "logistics", "transport", "manufacturing", "wholesale", "agriculture", "nonprofit"]
    }
  },
  "test_page": {
    "about": "Gap 5 (2026-11-17): a ScaleX-hosted page for a kept idea that measures interest — unique visits a day and unique 'I'd buy this at this price' clicks — with no personal data. Its lines are set when it is made (rule 41) and are these fixed values, not worked from the plan.",
    "min_visits": 100,
    "pass_rate_bp": 1000,
    "fail_below_rate_bp": 300,
    "max_pitch_chars": 120
  },
  "tests": {
    "about": "The cheapest next test for the riskiest assumption (I-30, D95). Pass and fail are worked out from the plan's own break-even before any result exists (rule 41), and kept with the result.",
    "presale": {
      "for": ["customers"],
      "customer": ["consumer"],
      "weeks": 4,
      "pass_share_of_break_even_bp": 2500,
      "fail_below_share_of_break_even_bp": 1000
    },
    "pilots": {
      "for": ["customers"],
      "customer": ["business", "both"],
      "weeks": 3,
      "conversations": 10,
      "pass_at_least": 3,
      "fail_at_most": 0
    },
    "quotes": {
      "for": ["variable_cost", "fixed_month"],
      "customer": ["consumer", "business", "both"],
      "weeks": 2,
      "quotes": 3
    }
  }
}
