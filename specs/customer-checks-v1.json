{
  "version": "1.0.0",
  "note": "P2-32: what potential customers check before they buy, per business_type (question 1.2). Presence on the owner's site is detected deterministically: a check is shown when any of its keywords appears in a fetched page's text or link targets (case-insensitive), starting at a word boundary; keywords of three letters or fewer must be whole words, so 'eur' never matches 'Europe' and 'ár' never matches 'nyár'. Keywords are deliberately short and plain; en and hu first (the bank's market scope). Extend freely — lib/blindspots/checks.test.ts holds this file to the bank's vocabulary.",
  "checks": {
    "opening_hours": {
      "label": { "en": "Opening hours" },
      "keywords": {
        "en": ["opening hours", "open daily", "hours of operation", "we are open", "opening times"],
        "hu": ["nyitvatartás", "nyitva tartás", "nyitva"]
      }
    },
    "prices": {
      "label": { "en": "Prices" },
      "keywords": {
        "en": ["price", "pricing", "€", "£", "$", "eur", "usd"],
        "hu": ["ár", "árak", "árlista", "ft", "huf"]
      }
    },
    "menu": {
