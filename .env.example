# Copy to .env and fill in. .env is gitignored and never committed.

# Port 5433, NOT the Postgres default 5432: docker-compose.yml maps the
# container to host port 5433 because a system Postgres commonly occupies
# 5432 (it does on the primary dev machine). If you change the mapping in
# docker-compose.yml, change it here too.
DATABASE_URL=postgresql://syb:syb_local_dev@127.0.0.1:5433/syb

# https://console.anthropic.com/ — required from Session L (interviewer).
ANTHROPIC_API_KEY=

# Question selection: "llm" (Sonnet, production) or "deterministic"
# (first open candidate in bank order — for UI dev and offline demos).
INTERVIEWER_MODE=deterministic

# P0-07b — Sentry error monitoring. Both empty = monitoring fully off.
# Server-side DSN (same value as the public one is fine for our setup).
SENTRY_DSN=
# Client-side DSN — NEXT_PUBLIC_ because the browser bundle needs it.
NEXT_PUBLIC_SENTRY_DSN=
# Shared secret for the deliberate-exception route /api/debug-sentry.
SENTRY_TEST_KEY=

# ── Session I: auth + payment ──────────────────────────────────────────

# Absolute origin used in emailed links and Stripe redirect URLs.
# Empty = derived from the request, which is right for local dev.
APP_URL=

# https://resend.com — magic-link login emails. Empty = the sign-in link
# is shown on screen instead of emailed (dev and pilot behaviour).
RESEND_API_KEY=
# The From: header Resend sends with. Must be a verified domain there.
EMAIL_FROM=

# https://dashboard.stripe.com/apikeys — payments. Empty = the report
# gate is UNARMED and generation is free (today's pilot behaviour).
# Use sk_test_… until go-live; every armed path works in test mode.
STRIPE_SECRET_KEY=
# https://dashboard.stripe.com/webhooks — signing secret of the endpoint
# pointed at /api/stripe/webhook. Required once STRIPE_SECRET_KEY is set.
STRIPE_WEBHOOK_SECRET=
# One-off report price in MINOR units + ISO currency. Empty = €49.00.
REPORT_PRICE_MINOR=
REPORT_CURRENCY=

# Shared secret for /ops and /api/ops (P1-53). Empty = both are off.
OPS_KEY=

# Vercel cron auth for /api/cron/weekly-watch (P1-46) and
# /api/cron/connector-sync (P2-06). Vercel sends it as
# "Authorization: Bearer <value>" automatically when set. Empty = off.
CRON_SECRET=

# ── Phase 2: connectors ────────────────────────────────────────────────

# P2-03 — encrypts owner connection secrets (Stripe keys, shop tokens) at
# rest with AES-256-GCM. 32 random bytes, base64 or hex. Required the
# moment a connector is connected; a lost key means every connection
# must be re-authorised. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTOR_KEY=

# ── Phase 3 Session D: publishing ──────────────────────────────────────

# P3-20c — Vercel Blob, where rendered clips and images wait at a public
# URL for the platform to fetch at publish time (Instagram cURLs media).
# Create a store in the Vercel dashboard (Storage → Blob) and paste its
# read-write token. Empty = attaching media to a content item fails
# loudly; drafting, planning and every test still work (in-memory store).
BLOB_READ_WRITE_TOKEN=
