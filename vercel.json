{
  "installCommand": "npm ci || npm ci --ignore-scripts",
  "buildCommand": "node scripts/vercel-build.mjs",
  "crons": [
    {
      "path": "/api/cron/weekly-watch",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/connector-sync",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/execute-due",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/faq-cluster",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/competitor-read",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/render-footage",
      "schedule": "45 5 * * *"
    },
    {
      "path": "/api/cron/push-held",
      "schedule": "0 7 * * *"
    }
  ]
}
