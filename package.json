{
  "name": "syb",
  "version": "0.15.0",
  "private": true,
  "description": "AI business operating system for small businesses — Phase 0: data layer, question engine, interviewer, intake UI",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "verify:caching": "tsx lib/interviewer/verify-caching.ts",
    "harness": "tsx lib/interviewer/harness/run.ts",
    "verify:parser": "tsx lib/parser/verify-parser.ts",
    "db:seed": "tsx scripts/seed-bank.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "cost:report": "tsx scripts/cost-report.ts",
    "verify:models": "tsx scripts/verify-models.ts",
    "recalibrate:diagnosis": "tsx scripts/recalibrate-diagnosis.ts",
    "smoke:email": "tsx scripts/smoke-email.ts",
    "smoke:inbound": "tsx scripts/smoke-inbound.ts",
    "smoke:erasure": "tsx scripts/smoke-erasure.ts",
    "smoke:widget": "tsx scripts/smoke-widget.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@sentry/nextjs": "^10.71.0",
    "@vercel/blob": "^2.8.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "next": "^16.3.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "undici": "^7.30.0"
  },
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 103",
    "safari >= 15.4"
  ],
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@sentry/cli@2.58.6": true
  }
